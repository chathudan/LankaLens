<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LankaLens.AdministrativeDivisions\LankaLens.AdministrativeDivisions.csproj" />
  </ItemGroup>

  <!--
    Derived Grama Niladhari coordinates, generated by DataBuilder's build-geo command.
    Linked rather than duplicated so the sample always ships the same file DataBuilder produced.
    Not part of the NuGet package - see docs/data-sources.md.
  -->
  <ItemGroup>
    <Content Include="..\..\data\generated\gnd-list-with-coordinates.csv"
             Link="gnd-list-with-coordinates.csv"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
