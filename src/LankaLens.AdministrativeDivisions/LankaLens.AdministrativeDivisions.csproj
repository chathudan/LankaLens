<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LankaLens.AdministrativeDivisions</RootNamespace>
    <AssemblyName>LankaLens.AdministrativeDivisions</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn)</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <VersionPrefix>2.0.0</VersionPrefix>
    <PackageId>LankaLens.AdministrativeDivisions</PackageId>
    <Title>LankaLens Administrative Divisions</Title>
    <Authors>Poorna Soysa</Authors>
    <Copyright>Copyright (c) 2026 Poorna Soysa</Copyright>
    <Description>
      Sri Lanka administrative divisions for .NET, including provinces,
      districts, divisional secretariats, and Grama Niladhari divisions
      with English names and authoritative Sinhala/Tamil names when available.
    </Description>
    <PackageTags>sri-lanka;administrative-divisions;province;district;divisional-secretariat;grama-niladhari;sinhala;tamil</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/poorna-soysa/LankaLens</PackageProjectUrl>
    <RepositoryUrl>https://github.com/poorna-soysa/LankaLens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageReleaseNotes>
  LankaLens.AdministrativeDivisions 2.0.0

  BREAKING CHANGE: target framework moved from net8.0 to net10.0.
  Consumers on .NET 8 or .NET 9 must stay on the 1.x line; the public
  API surface itself is unchanged from 1.0.0.

  Included data:
  - 9 Provinces
  - 25 Districts
  - 340 Divisional Secretariat Divisions
  - 14,008 Grama Niladhari Divisions
  - Complete English coverage
  - Sinhala and Tamil names where authoritative values are available

  Features:
  - Offline embedded administrative dataset
  - Code-based lookups
  - Province → District → DS → GN hierarchy navigation
  - Multilingual search
  - Thread-safe read-only API
  - No database or external API required
</PackageReleaseNotes>
    <PackageOutputPath>$(RepoRoot)artifacts/packages/</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!--
    Baseline reset for the 2.0.0 net10.0 retarget (see docs/versioning.md
    "Approving an intentional breaking change" - regenerate-the-baseline path).
    The prior baseline (0.1.0-preview.1, lib/net8.0) is deliberately not
    referenced here: comparing a net10.0-only package against a net8.0-only
    baseline would fail package validation on the TFM removal itself, which
    is exactly the accepted, intentional break. Once eng/api-compat/
    LankaLens.AdministrativeDivisions.2.0.0.nupkg is produced and committed,
    this condition picks it up automatically and validation resumes guarding
    against further, unintended API breaks from this new baseline forward.
  -->
  <PropertyGroup Condition="Exists('$(RepoRoot)eng/api-compat/LankaLens.AdministrativeDivisions.2.0.0.nupkg')">
    <PackageValidationBaselinePath>$(RepoRoot)eng/api-compat/LankaLens.AdministrativeDivisions.2.0.0.nupkg</PackageValidationBaselinePath>
  </PropertyGroup>

 <ItemGroup>
  <None Include="README.md" Pack="true" PackagePath="\" />
  <None Include="..\..\DATA-NOTICE.md" Pack="true" PackagePath="\" />
  <None Include="$(RepoRoot)assets\icon.png" Pack="true" PackagePath="\" />
</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\administrative-divisions.json">
      <LogicalName>LankaLens.AdministrativeDivisions.Data.administrative-divisions.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LankaLens.AdministrativeDivisions.Tests" />
  </ItemGroup>

</Project>
